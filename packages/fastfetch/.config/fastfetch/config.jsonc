{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "macos",
    "padding": {
      "top": 1,
      "right": 3
    },
    "color": {
      "1": "38;2;243;139;168",
      "2": "38;2;250;179;135",
      "3": "38;2;249;226;175",
      "4": "38;2;166;227;161",
      "5": "38;2;116;199;236",
      "6": "38;2;203;166;247"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    },
    "color": {
      "title": "38;2;180;190;254",
      "keys": "38;2;203;166;247",
      "separator": "38;2;108;112;134"
    },
    "percent": {
      "type": ["num", "bar"]
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "elapsed": "38;2;166;227;161",
        "total": "38;2;69;71;90"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#38;2;88;91;112}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "os",
      "key": "    OS",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "host",
      "key": "  󰌢  Machine",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "kernel",
      "key": "    Kernel",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "uptime",
      "key": "  󰅐  Uptime",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "cpu",
      "key": "    Chip",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "memory",
      "key": "    Memory",
      "keyColor": "38;2;166;227;161",
      "format": "{used} / {total}  {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "  󰋊  Storage",
      "keyColor": "38;2;166;227;161",
      "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
    },
    {
      "type": "battery",
      "key": "  󰁹  Battery",
      "keyColor": "38;2;249;226;175",
      "format": "{capacity-bar} {capacity}  {status}"
    },
    {
      "type": "shell",
      "key": "    Shell",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "terminal",
      "key": "  󰆍  Terminal",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "packages",
      "key": "  󰏖  Packages",
      "keyColor": "38;2;203;166;247"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
